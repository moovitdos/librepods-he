    <string name="privacy_policy_last_updated">עודכן לאחרונה: 20 ביוני 2026</string>
    <string name="privacy_policy_overview">סקירה כללית</string>
    <string name="privacy_policy_overview_no_collection">LibrePods אינה אוספת, שומרת, מוכרת או משתפת מידע אישי למטרות פרסום, ניתוח נתונים, מעקב או יצירת פרופילים. האפליקציה אינה כוללת כלי ניתוח נתונים, דיווח קריסות, טלמטריה, ערכות פרסום (SDK) או שירותי מעקב.</string>
    <string name="privacy_policy_overview_on_device">כל המידע נשאר במכשיר שלך, אלא אם תבחר במפורש ליצור איתי קשר, לפתוח דיווח (issue) ב-GitHub מתוך האפליקציה, או לבצע רכישה או חסות דרך פלטפורמה של צד שלישי.</string>
    <string name="privacy_policy_third_party_services">שירותי צד שלישי</string>
    <string name="privacy_policy_contact_methods">LibrePods מציעה כמה דרכים ליצור איתי קשר, כולל אימייל, Discord ו-GitHub Issues.</string>
    <string name="privacy_policy_email">אימייל</string>
    <string name="privacy_policy_email_details">אם תיצור איתי קשר באמצעות אימייל, אקבל את כתובת האימייל שלך וכל מידע שתבחר לכלול בהודעתך. בעת שימוש בטופס יצירת הקשר בתוך LibrePods, תוכנת האימייל שלך תיפתח עם כתובת אימייל ממולאת מראש, יחד עם שורת הנושא וגוף ההודעה שתמלא. גוף ההודעה יכלול גם מידע על גרסת LibrePods ומידע על המכשיר כדי לסייע באיתור תקלות.</string>
    <string name="privacy_policy_email_edit_before_sending">תוכל לערוך או להסיר כל אחד מפרטי המידע האלה לפני שליחת האימייל.</string>
    <string name="privacy_policy_discord_link">האפליקציה מספקת קישור לשרת ה-Discord של LibrePods. אם תבחר להצטרף לשרת ה-Discord, תהיה כפוף למדיניות הפרטיות של Discord.</string>
    <string name="privacy_policy_discord_no_info">אינני מקבל שום מידע עליך מ-Discord מלבד מה שגלוי לציבור בשרת ה-Discord, כגון שם המשתמש שלך, תאריך ההצטרפות, שרתים משותפים וכל הודעה או תוכן שתפרסם בשרת, אלא אם תבחר לשתף אותם איתי בשרת ה-Discord.</string>
    <string name="privacy_policy_github_issue_prefill">בעת פתיחת דיווח (issue) ב-GitHub דרך LibrePods, האפליקציה תמלא מראש את טופס הדיווח עם:</string>
    <string name="privacy_policy_issue_version_info">• שם גרסת LibrePods וקוד הגרסה</string>
    <string name="privacy_policy_issue_device_info">• יצרן ודגם המכשיר</string>
    <string name="privacy_policy_issue_android_build">• פרטי ה-build של Android</string>
    <string name="privacy_policy_issue_install_source">• מקור ההתקנה (Google Play או GitHub)</string>
    <string name="privacy_policy_issue_not_automatic">מידע זה מסייע באבחון תקלות ובמתן תמיכה. שום מידע אינו נשלח באופן אוטומטי. המידע נשלח רק אם תבחר לפתוח את הדיווח ב-GitHub.</string>
    <string name="privacy_policy_payments">תשלומים</string>
    <string name="privacy_policy_google_play_purchases">בעת שימוש בגרסה הזמינה ב-Google Play, הרכישות מעובדות על ידי Google Play.</string>
    <string name="privacy_policy_google_play_verification">LibrePods מאמתת את הרכישה מול Google Play במכשיר עצמו, ולא מול שרת מרוחק שבשליטתי. אינני מקבל שום מידע עליך או על הרכישה שלך מ-Google Play. עיבוד התשלום מתבצע כולו על ידי Google Play, ואין לי גישה לשום פרט מפרטי התשלום שלך.</string>
    <string name="privacy_policy_github_sponsors_link">בעת שימוש בגרסת ה-FOSS הזמינה ב-GitHub, כפתור השדרוג מקשר ל-GitHub Sponsors. אם תבחר להעניק חסות ל-LibrePods, החסות שלך מעובדת על ידי GitHub.</string>
    <string name="privacy_policy_github_sponsors_shared_info">שם המשתמש שלך והמדינה/אזור שלך משותפים איתי כאשר אתה מעניק חסות ל-LibrePods. בהתאם להגדרות הפרטיות שלך ב-GitHub Sponsors, ייתכן שאקבל גם את כתובת האימייל שלך.</string>
    <string name="privacy_policy_contact_details">אם יש לך שאלות בנוגע למדיניות פרטיות זו, אנא צור איתי קשר באמצעות אימייל בכתובת privacy@kavish.xyz.</string>
